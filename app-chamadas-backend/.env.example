PORT=3333
# Origens do frontend, separadas por vírgula.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Use none quando frontend e backend estiverem em sites diferentes e HTTPS.
COOKIE_SAME_SITE=lax
DATABASE_URL=file:./dev.db
# Em producao, DATABASE_URL deve ser poolada; DIRECT_URL e usada somente pelo Prisma CLI.
# DIRECT_URL=postgresql://usuario:senha@host-sem-pool/banco?sslmode=require
NODE_ENV=development

# Necessario em producao com mais de uma instancia. A integracao gratuita
# Upstash Redis da Vercel fornece REDIS_URL (KV_URL tambem e aceito).
# REDIS_URL=rediss://default:senha@host:6379

# Armazenamento persistente dos anexos na Vercel (store privado).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Com OIDC, configure BLOB_STORE_ID e mantenha VERCEL_OIDC_TOKEN automatico.

# Opcionais: credenciais server-side para TURN gerenciado. Nunca use VITE_ aqui.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Obrigatórias para o envio real da verificação de e-mail.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-smtp
EMAIL_FROM="Nexa <noreply@example.com>"
