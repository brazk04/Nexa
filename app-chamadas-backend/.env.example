PORT=3333
# Origens do frontend, separadas por vírgula.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Use none quando frontend e backend estiverem em sites diferentes e HTTPS.
COOKIE_SAME_SITE=lax
DATABASE_URL=file:./dev.db
NODE_ENV=development

# Obrigatórias para o envio real da verificação de e-mail.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-smtp
EMAIL_FROM="Nexa <noreply@example.com>"
