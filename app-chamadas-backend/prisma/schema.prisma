generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                 String                   @id @default(cuid())
  username           String                   @unique
  usernameNormalized String                   @unique
  displayName        String?
  email              String                   @unique
  emailNormalized    String                   @unique
  passwordHash       String
  birthDate          DateTime
  avatarPath         String?
  emailVerifiedAt    DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  createdRooms       Room[]                   @relation("RoomOwner")
  memberships        RoomMember[]
  messages           Mensagem[]
  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  preferences        UserPreference?
  mentions           MessageMention[]
  callAttendances    CallAttendance[]
  agendaItems        AgendaItem[]
  decisions          Decision[]
  assignedActions    ActionItem[]              @relation("ActionAssignee")
  createdActions     ActionItem[]              @relation("ActionCreator")
}

model UserPreference {
  userId               String  @id
  theme                String  @default("system")
  fontScale            Int     @default(100)
  density              String  @default("comfortable")
  reduceMotion         Boolean @default(false)
  accent               String  @default("violet")
  sounds               Boolean @default(true)
  messageNotifications Boolean @default(true)
  mentionNotifications Boolean @default(true)
  callNotifications    Boolean @default(true)
  doNotDisturb          Boolean @default(false)
  status                String  @default("online")
  cameraId              String?
  microphoneId          String?
  speakerId             String?
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id          String         @id @default(cuid())
  name        String
  description String         @default("")
  code        String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String
  createdBy   User           @relation("RoomOwner", fields: [createdById], references: [id], onDelete: Restrict)
  members     RoomMember[]
  messages    Mensagem[]
  calls       CallHistory[]
  agenda      AgendaItem[]
  decisions   Decision[]
  actions     ActionItem[]
}

model RoomMember {
  userId              String
  roomId              String
  joinedAt            DateTime @default(now())
  lastReadAt          DateTime @default(now())
  favorite            Boolean  @default(false)
  notificationsEnabled Boolean @default(true)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room                Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@index([roomId])
}

model Mensagem {
  id        Int       @id @default(autoincrement())
  autor     String
  texto     String
  sala      String    @default("geral")
  criadoEm  DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  userId    String?
  roomId    String?
  replyToId Int?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  replyTo   Mensagem? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Mensagem[] @relation("MessageReplies")
  mentions  MessageMention[]
  attachments Attachment[]

  @@index([roomId, criadoEm])
  @@index([userId])
  @@index([replyToId])
}

model MessageMention {
  messageId Int
  userId    String
  message   Mensagem @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model Attachment {
  id         String   @id @default(cuid())
  messageId  Int
  name       String
  storedName String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
  message    Mensagem @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Session {
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id                 String   @id @default(cuid())
  tokenHash          String   @unique
  userId             String
  purpose            String   @default("registration")
  newEmail           String?
  newEmailNormalized String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CallHistory {
  id           String           @id
  roomId       String
  startedAt    DateTime         @default(now())
  endedAt      DateTime?
  room         Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants CallAttendance[]

  @@index([roomId, startedAt])
}

model CallAttendance {
  callId   String
  userId   String
  joinedAt DateTime @default(now())
  leftAt   DateTime?
  call     CallHistory @relation(fields: [callId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
  @@index([userId])
}

model AgendaItem {
  id              String    @id @default(cuid())
  roomId          String
  text            String
  completed       Boolean   @default(false)
  position        Int       @default(0)
  resolvedAsyncAt DateTime?
  createdAt       DateTime  @default(now())
  createdById     String
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy       User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([roomId, position])
}

model Decision {
  id        String   @id @default(cuid())
  roomId    String
  text      String
  createdAt DateTime @default(now())
  authorId  String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model ActionItem {
  id          String    @id @default(cuid())
  roomId      String
  description String
  status      String    @default("pending")
  deadline    DateTime?
  assigneeId  String?
  createdById String
  createdAt   DateTime  @default(now())
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User      @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@index([assigneeId])
}
